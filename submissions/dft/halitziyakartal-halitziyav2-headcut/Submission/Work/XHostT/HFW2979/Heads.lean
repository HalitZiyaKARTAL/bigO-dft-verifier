open Binary Matrix Finset RAM SS CB RF BR GF GX XHost XHostT
noncomputable section

section Heads
variable {H T Sl C α Γ : Type} [Fintype H] [DecidableEq H] [Fintype T] [DecidableEq T]
  [Fintype Sl] [DecidableEq Sl] [Fintype C] [DecidableEq C] [Fintype α] [DecidableEq α]
  [Fintype Γ] [DecidableEq Γ]
variable {nb nR : ℕ} {Ok : ∀ {β : Type} [Fintype β] [DecidableEq β], GWin H β → Prop}

/-- the role product of the head word of pair `p` on a data role of pair `q`. -/
lemma rp_headsP {p : ℕ} (hp : 1 ≤ p ∧ p ≤ 4) (hb : Finset (Fin nR × Bool × T)) {n : ℕ}
    (z : BLiveT Γ T nb nR → Fin n → Space α) (ind : ∀ l, LinearIndependent F (z l)) (ρ : Fin nR) {q : ℕ}
    (hq : 1 ≤ q ∧ q ≤ 4) (s : Bool) (g : Γ) (t : T) :
    MX.roleProd (MX.headWord (Sum.inl : BLiveT Γ T nb nR → BRoleT Γ T nb C nR) (headsLP p hb) (fun _ => n) z ind)
      (Sum.inl (Sum.inl (ρ, dD q s (g, t)))) = if q = p then hdHFP p hb z ρ g (s, t) else 1 := by
  rw [MX.roleProd_headWord_e Sum.inl_injective _ (headsLP_nodup p hb)]
  by_cases hqp : q = p
  · subst hqp
    rw [if_pos rfl]
    unfold hdHFP
    by_cases h : (ρ, (s, t)) ∈ hb
    · rw [if_pos (show (Sum.inl (ρ, dD q s (g, t)) : BLiveT Γ T nb nR) ∈ headsLP q hb from
        (mem_headsLP_iff hp hb ρ g (s, t)).2 h), if_pos h]
      rfl
    · rw [if_neg (show (Sum.inl (ρ, dD q s (g, t)) : BLiveT Γ T nb nR) ∉ headsLP q hb from
        fun h' => h ((mem_headsLP_iff hp hb ρ g (s, t)).1 h')), if_neg h]
  · rw [if_neg hqp, if_neg]
    intro h
    obtain ⟨x, -, g', e⟩ := (mem_headsLP p hb _).1 h
    exact hroleP_ne_pair hp hq hqp ρ x.1 s (g, t) g' x.2 e.symm

/-- the role product of the head word of pair `p` on a bank role or a copy role: `1`. -/
lemma rp_headsP_bank {p : ℕ} (hb : Finset (Fin nR × Bool × T)) {n : ℕ}
    (z : BLiveT Γ T nb nR → Fin n → Space α) (ind : ∀ l, LinearIndependent F (z l)) (gb : Γ × Fin nb) :
    MX.roleProd (MX.headWord (Sum.inl : BLiveT Γ T nb nR → BRoleT Γ T nb C nR) (headsLP p hb) (fun _ => n) z ind)
      (Sum.inl (Sum.inr gb)) = 1 := by
  rw [MX.roleProd_headWord_e Sum.inl_injective _ (headsLP_nodup p hb), if_neg]
  intro h
  obtain ⟨x, -, g', e⟩ := (mem_headsLP p hb _).1 h
  exact hroleP_ne_bank p gb x.1 g' x.2 e.symm

lemma rp_headsP_copy {p : ℕ} (hb : Finset (Fin nR × Bool × T)) {n : ℕ}
    (z : BLiveT Γ T nb nR → Fin n → Space α) (ind : ∀ l, LinearIndependent F (z l)) (gc : Γ × C) :
    MX.roleProd (MX.headWord (Sum.inl : BLiveT Γ T nb nR → BRoleT Γ T nb C nR) (headsLP p hb) (fun _ => n) z ind)
      (Sum.inr gc) = 1 :=
  MX.roleProd_headWord_off (headsLP p hb) (fun _ => n) z ind (Sum.inr gc) (fun l h => by cases h)

/-- the head prefix of the three head kinds acts on every role by its role product, the body network's pre-factor. -/
lemma roleProd_heads3_hdT (N : XNetHW H T Sl C α Γ nb nR Ok) (hb2 hb3 hb4 : Finset (Fin nR × Bool × T))
    (z2 : BLiveT Γ T nb nR → Fin 16 → Space α) (z3 : BLiveT Γ T nb nR → Fin 32 → Space α)
    (z4 : BLiveT Γ T nb nR → Fin 48 → Space α) (ind2 : ∀ l, LinearIndependent F (z2 l))
    (ind3 : ∀ l, LinearIndependent F (z3 l)) (ind4 : ∀ l, LinearIndependent F (z4 l))
    (hhd2 : ∀ ρ g j, N.hd2 ρ g j = hdHFP 2 hb2 z2 ρ g j) (hhd3 : ∀ ρ g j, N.hd3 ρ g j = hdHFP 3 hb3 z3 ρ g j)
    (hhd4 : ∀ ρ g j, N.hd ρ g j = hdHFP 4 hb4 z4 ρ g j) (r : BRoleT Γ T nb C nR) :
    MX.roleProd (MX.headWord (Sum.inl : BLiveT Γ T nb nR → BRoleT Γ T nb C nR) (headsLP 2 hb2) (fun _ => 16) z2 ind2
      ++ (MX.headWord Sum.inl (headsLP 3 hb3) (fun _ => 32) z3 ind3
        ++ MX.headWord Sum.inl (headsLP 4 hb4) (fun _ => 48) z4 ind4)) r = N.hdT r := by
  rw [MX.roleProd_append, MX.roleProd_append]
  rcases r with ((⟨ρ, d⟩ | ⟨g0, b0⟩) | ⟨g0, c0⟩)
  · obtain ⟨q, s, ⟨g, t⟩, hq, rfl⟩ := dD_cases d
    rw [rp_headsP (p := 4) ⟨by norm_num, by norm_num⟩ hb4 z4 ind4 ρ hq s g t,
      rp_headsP (p := 3) ⟨by norm_num, by norm_num⟩ hb3 z3 ind3 ρ hq s g t,
      rp_headsP (p := 2) ⟨by norm_num, by norm_num⟩ hb2 z2 ind2 ρ hq s g t]
    obtain ⟨h1, h4⟩ := hq
    interval_cases q <;> cases s
    · show (if (1 : ℕ) = 4 then _ else 1) * (if (1 : ℕ) = 3 then _ else 1) * (if (1 : ℕ) = 2 then _ else 1) = 1
      simp
    · show (if (1 : ℕ) = 4 then _ else 1) * (if (1 : ℕ) = 3 then _ else 1) * (if (1 : ℕ) = 2 then _ else 1) = 1
      simp
    · show (if (2 : ℕ) = 4 then _ else 1) * (if (2 : ℕ) = 3 then _ else 1)
          * (if (2 : ℕ) = 2 then hdHFP 2 hb2 z2 ρ g (false, t) else 1) = N.hd2 ρ g (false, t)
      simp [hhd2]
    · show (if (2 : ℕ) = 4 then _ else 1) * (if (2 : ℕ) = 3 then _ else 1)
          * (if (2 : ℕ) = 2 then hdHFP 2 hb2 z2 ρ g (true, t) else 1) = N.hd2 ρ g (true, t)
      simp [hhd2]
    · show (if (3 : ℕ) = 4 then _ else 1) * (if (3 : ℕ) = 3 then hdHFP 3 hb3 z3 ρ g (false, t) else 1)
          * (if (3 : ℕ) = 2 then _ else 1) = N.hd3 ρ g (false, t)
      simp [hhd3]
    · show (if (3 : ℕ) = 4 then _ else 1) * (if (3 : ℕ) = 3 then hdHFP 3 hb3 z3 ρ g (true, t) else 1)
          * (if (3 : ℕ) = 2 then _ else 1) = N.hd3 ρ g (true, t)
      simp [hhd3]
    · show (if (4 : ℕ) = 4 then hdHFP 4 hb4 z4 ρ g (false, t) else 1) * (if (4 : ℕ) = 3 then _ else 1)
          * (if (4 : ℕ) = 2 then _ else 1) = N.hd ρ g (false, t)
      simp [hhd4]
    · show (if (4 : ℕ) = 4 then hdHFP 4 hb4 z4 ρ g (true, t) else 1) * (if (4 : ℕ) = 3 then _ else 1)
          * (if (4 : ℕ) = 2 then _ else 1) = N.hd ρ g (true, t)
      simp [hhd4]
  · rw [rp_headsP_bank (p := 4) hb4 z4 ind4 (g0, b0), rp_headsP_bank (p := 3) hb3 z3 ind3 (g0, b0),
      rp_headsP_bank (p := 2) hb2 z2 ind2 (g0, b0)]
    simp only [Matrix.one_mul]
    rfl
  · rw [rp_headsP_copy (p := 4) hb4 z4 ind4 (g0, c0), rp_headsP_copy (p := 3) hb3 z3 ind3 (g0, c0),
      rp_headsP_copy (p := 2) hb2 z2 ind2 (g0, c0)]
    simp only [Matrix.one_mul]
    rfl

/-- **The heads-first certificate of a network with head pre-factors on the A2, A3 and A4 data.** -/
theorem XNetHW.heads_first3 (N : XNetHW H T Sl C α Γ nb nR Ok) (hb2 hb3 hb4 : Finset (Fin nR × Bool × T))
    (z2 : BLiveT Γ T nb nR → Fin 16 → Space α) (z3 : BLiveT Γ T nb nR → Fin 32 → Space α)
    (z4 : BLiveT Γ T nb nR → Fin 48 → Space α) (ind2 : ∀ l, LinearIndependent F (z2 l))
    (ind3 : ∀ l, LinearIndependent F (z3 l)) (ind4 : ∀ l, LinearIndependent F (z4 l))
    (hhd2 : ∀ ρ g j, N.hd2 ρ g j = hdHFP 2 hb2 z2 ρ g j) (hhd3 : ∀ ρ g j, N.hd3 ρ g j = hdHFP 3 hb3 z3 ρ g j)
    (hhd4 : ∀ ρ g j, N.hd ρ g j = hdHFP 4 hb4 z4 ρ g j) :
    ∃ body : GWord α (BRoleT Γ T nb C nR), body.Proper (Fintype.card α) ∧
      (∀ φ, body.costR φ = (Fintype.card Γ : ℝ) * N.unit φ) ∧
      GLiveKernel (Sum.inl : BLiveT Γ T nb nR → BRoleT Γ T nb C nR)
        (MX.headWord Sum.inl (headsLP 2 hb2) (fun _ => 16) z2 ind2
          ++ (MX.headWord Sum.inl (headsLP 3 hb3) (fun _ => 32) z3 ind3
            ++ (MX.headWord Sum.inl (headsLP 4 hb4) (fun _ => 48) z4 ind4 ++ body))) := by
  obtain ⟨body, hP, hc, hk⟩ := N.cert_pre (MX.headWord (Sum.inl : BLiveT Γ T nb nR → BRoleT Γ T nb C nR)
      (headsLP 2 hb2) (fun _ => 16) z2 ind2 ++ (MX.headWord Sum.inl (headsLP 3 hb3) (fun _ => 32) z3 ind3
        ++ MX.headWord Sum.inl (headsLP 4 hb4) (fun _ => 48) z4 ind4)) (fun f x => by
    funext r
    rw [MX.gwalk_local f _ ((MX.roleLocal_headWord _ _ _ _ _).append
      ((MX.roleLocal_headWord _ _ _ _ _).append (MX.roleLocal_headWord _ _ _ _ _)))]
    show matAct f _ (matAct f (N.S0 r) (x r)) = matAct f (N.Ffr 0 r) (x r)
    rw [matAct_mul, N.Ffr0_eq r, roleProd_heads3_hdT N hb2 hb3 hb4 z2 z3 z4 ind2 ind3 ind4 hhd2 hhd3 hhd4 r])
  refine ⟨body, hP, hc, ?_⟩
  simpa only [List.append_assoc] using hk

/-- **THE HEADS-FIRST CERTIFICATE, three head kinds.**  p-a3's cross-replica network `N`, never hosted head bins
`hb2` (A2, remaining climb 16), `hb3` (A3, 32) and `hb4` (A4, 48), and head directions with which ONE block takes
each head's start frame to its end frame up to a free step: the three head words (all first) followed by a proper
`body` are a scratch certificate on the live roles, and the body costs the network's price less the heads. -/
theorem XNetW.heads_first3 (N : XNetW H T Sl C α Γ nb nR Ok) (hb2 hb3 hb4 : Finset (Fin nR × Bool × T))
    (hunh : ∀ ρ l q ρh c j, isHd hb2 hb3 hb4 ρh c j → N.hostAt ρ l q ≠ some (ρh, c, j))
    (hf2 : ∀ ρ j, (ρ, j) ∈ hb2 → N.hrem ρ 0 j = 16) (hf3 : ∀ ρ j, (ρ, j) ∈ hb3 → N.hrem ρ 2 j = 32)
    (hf4 : ∀ ρ j, (ρ, j) ∈ hb4 → N.hrem ρ 4 j = 48)
    (z2 : BLiveT Γ T nb nR → Fin 16 → Space α) (z3 : BLiveT Γ T nb nR → Fin 32 → Space α)
    (z4 : BLiveT Γ T nb nR → Fin 48 → Space α) (ind2 : ∀ l, LinearIndependent F (z2 l))
    (ind3 : ∀ l, LinearIndependent F (z3 l)) (ind4 : ∀ l, LinearIndependent F (z4 l))
    (hz2 : ∀ ρ j, (ρ, j) ∈ hb2 → ∀ g, GReach (blockMat (z2 (hroleP 2 ρ g j)) * N.x0A4 g j) (N.x1A2 g j) (fun _ => 0))
    (hz3 : ∀ ρ j, (ρ, j) ∈ hb3 → ∀ g, GReach (blockMat (z3 (hroleP 3 ρ g j)) * N.x0A4 g j) (N.x1A3 g j) (fun _ => 0))
    (hz4 : ∀ ρ j, (ρ, j) ∈ hb4 → ∀ g, GReach (blockMat (z4 (hroleP 4 ρ g j)) * N.x0A4 g j) (N.x1A4 g j) (fun _ => 0)) :
    ∃ body : GWord α (BRoleT Γ T nb C nR), body.Proper (Fintype.card α) ∧
      (∀ φ, body.costR φ = (Fintype.card Γ : ℝ) * N.unit φ
        - (((headsLP (Γ := Γ) (nb := nb) 2 hb2).length : ℝ) * φ 16
          + ((headsLP (Γ := Γ) (nb := nb) 3 hb3).length : ℝ) * φ 32
          + ((headsLP (Γ := Γ) (nb := nb) 4 hb4).length : ℝ) * φ 48)) ∧
      GLiveKernel (Sum.inl : BLiveT Γ T nb nR → BRoleT Γ T nb C nR)
        (MX.headWord Sum.inl (headsLP 2 hb2) (fun _ => 16) z2 ind2
          ++ (MX.headWord Sum.inl (headsLP 3 hb3) (fun _ => 32) z3 ind3
            ++ (MX.headWord Sum.inl (headsLP 4 hb4) (fun _ => 48) z4 ind4 ++ body))) := by
  obtain ⟨body, hP, hc, hk⟩ := (N.toHF hb2 hb3 hb4 z2 z3 z4 hunh hz2 hz3 hz4).heads_first3 hb2 hb3 hb4 z2 z3 z4
    ind2 ind3 ind4 (fun ρ g j => rfl) (fun ρ g j => rfl) (fun ρ g j => rfl)
  refine ⟨body, hP, fun φ => ?_, hk⟩
  rw [hc φ, N.unit_toHF hb2 hb3 hb4 z2 z3 z4 hunh hz2 hz3 hz4 hf2 hf3 hf4,
    headsLP_length (p := 2) ⟨by norm_num, by norm_num⟩, headsLP_length (p := 3) ⟨by norm_num, by norm_num⟩,
    headsLP_length (p := 4) ⟨by norm_num, by norm_num⟩]
  push_cast
  ring

end Heads
