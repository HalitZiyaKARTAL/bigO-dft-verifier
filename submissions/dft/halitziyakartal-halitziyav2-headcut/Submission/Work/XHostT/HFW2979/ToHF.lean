/-! ## The price of the body network -/

variable (hunh : ∀ ρ l q ρh c j, isHd hb2 hb3 hb4 ρh c j → N.hostAt ρ l q ≠ some (ρh, c, j))
  (hz2 : ∀ ρ j, (ρ, j) ∈ hb2 → ∀ g, GReach (blockMat (z2 (hroleP 2 ρ g j)) * N.x0A4 g j) (N.x1A2 g j) (fun _ => 0))
  (hz3 : ∀ ρ j, (ρ, j) ∈ hb3 → ∀ g, GReach (blockMat (z3 (hroleP 3 ρ g j)) * N.x0A4 g j) (N.x1A3 g j) (fun _ => 0))
  (hz4 : ∀ ρ j, (ρ, j) ∈ hb4 → ∀ g, GReach (blockMat (z4 (hroleP 4 ρ g j)) * N.x0A4 g j) (N.x1A4 g j) (fun _ => 0))

lemma XNetW.hcost_toHF_ne (ρ : Fin nR) {c : Fin 9} (hc : ¬ (c = 0 ∨ c = 2 ∨ c = 4)) (φ : ℕ → ℝ) :
    (N.toHF hb2 hb3 hb4 z2 z3 z4 hunh hz2 hz3 hz4).hcost ρ c φ = N.hcost ρ c φ := by
  show ∑ t : T, (bcost φ (N.hremHF hb2 hb3 hb4 ρ c (false, t)) + bcost φ (N.hremHF hb2 hb3 hb4 ρ c (true, t)))
    = N.hcost ρ c φ
  simp only [N.hremHF_ne hb2 hb3 hb4 hc]
  rfl

/-- the price of the remaining climbs of a head kind `c` with data pair `p`, rank `r` and head bins `hb`. -/
lemma XNetW.hcost_toHF_K {c : Fin 9} {r : ℕ} (hr : r ≠ 0) {hb : Finset (Fin nR × Bool × T)}
    (hK : ∀ ρ j, isHd hb2 hb3 hb4 ρ c j ↔ (ρ, j) ∈ hb) (hfull : ∀ ρ j, (ρ, j) ∈ hb → N.hrem ρ c j = r)
    (ρ : Fin nR) (φ : ℕ → ℝ) :
    (N.toHF hb2 hb3 hb4 z2 z3 z4 hunh hz2 hz3 hz4).hcost ρ c φ = N.hcost ρ c φ - hdropR r hb ρ φ := by
  show ∑ t : T, (bcost φ (N.hremHF hb2 hb3 hb4 ρ c (false, t)) + bcost φ (N.hremHF hb2 hb3 hb4 ρ c (true, t))) = _
  have e : ∀ j, bcost φ (N.hremHF hb2 hb3 hb4 ρ c j) = bcost φ (N.hrem ρ c j) - (if (ρ, j) ∈ hb then φ r else 0) := by
    intro j
    unfold XNetW.hremHF
    by_cases h : (ρ, j) ∈ hb
    · rw [if_pos ((hK ρ j).2 h), if_pos h, hfull ρ j h, bcost_zero, bcost_pos φ hr]
      ring
    · rw [if_neg (fun h' => h ((hK ρ j).1 h')), if_neg h]
      ring
  simp only [e, XNetW.hcost, hdropR, ← Finset.sum_sub_distrib]
  apply Finset.sum_congr rfl
  intro t _
  ring

variable (hf2 : ∀ ρ j, (ρ, j) ∈ hb2 → N.hrem ρ 0 j = 16) (hf3 : ∀ ρ j, (ρ, j) ∈ hb3 → N.hrem ρ 2 j = 32)
  (hf4 : ∀ ρ j, (ρ, j) ∈ hb4 → N.hrem ρ 4 j = 48)

/-- the drops of the three head kinds, charged at the tails of calls 1 (A2), 3 (A3) and 5 (A4). -/
def dropAt (ρ : Fin nR) (l : Fin 9) (φ : ℕ → ℝ) : ℝ :=
  (if l = 1 then hdropR 16 hb2 ρ φ else 0) + (if l = 3 then hdropR 32 hb3 ρ φ else 0)
    + (if l = 5 then hdropR 48 hb4 ρ φ else 0)

include hf2 hf3 hf4 in
lemma XNetW.tailU_toHF (ρ : Fin nR) (l : Fin 9) (φ : ℕ → ℝ) :
    (N.toHF hb2 hb3 hb4 z2 z3 z4 hunh hz2 hz3 hz4).tailU ρ l φ = N.tailU ρ l φ - dropAt hb2 hb3 hb4 ρ l φ := by
  have k0 := N.hcost_toHF_K hb2 hb3 hb4 z2 z3 z4 hunh hz2 hz3 hz4 (c := 0) (by norm_num) (isHd_0 hb2 hb3 hb4) hf2 ρ φ
  have k2 := N.hcost_toHF_K hb2 hb3 hb4 z2 z3 z4 hunh hz2 hz3 hz4 (c := 2) (by norm_num) (isHd_2 hb2 hb3 hb4) hf3 ρ φ
  have k4 := N.hcost_toHF_K hb2 hb3 hb4 z2 z3 z4 hunh hz2 hz3 hz4 (c := 4) (by norm_num) (isHd_4 hb2 hb3 hb4) hf4 ρ φ
  have n1 := N.hcost_toHF_ne hb2 hb3 hb4 z2 z3 z4 hunh hz2 hz3 hz4 ρ (show ¬(((1 : Fin 9) = 0) ∨ ((1 : Fin 9) = 2) ∨ ((1 : Fin 9) = 4)) by decide) φ
  have n3 := N.hcost_toHF_ne hb2 hb3 hb4 z2 z3 z4 hunh hz2 hz3 hz4 ρ (show ¬(((3 : Fin 9) = 0) ∨ ((3 : Fin 9) = 2) ∨ ((3 : Fin 9) = 4)) by decide) φ
  have n5 := N.hcost_toHF_ne hb2 hb3 hb4 z2 z3 z4 hunh hz2 hz3 hz4 ρ (show ¬(((5 : Fin 9) = 0) ∨ ((5 : Fin 9) = 2) ∨ ((5 : Fin 9) = 4)) by decide) φ
  have n6 := N.hcost_toHF_ne hb2 hb3 hb4 z2 z3 z4 hunh hz2 hz3 hz4 ρ (show ¬(((6 : Fin 9) = 0) ∨ ((6 : Fin 9) = 2) ∨ ((6 : Fin 9) = 4)) by decide) φ
  have n7 := N.hcost_toHF_ne hb2 hb3 hb4 z2 z3 z4 hunh hz2 hz3 hz4 ρ (show ¬(((7 : Fin 9) = 0) ∨ ((7 : Fin 9) = 2) ∨ ((7 : Fin 9) = 4)) by decide) φ
  have n8 := N.hcost_toHF_ne hb2 hb3 hb4 z2 z3 z4 hunh hz2 hz3 hz4 ρ (show ¬(((8 : Fin 9) = 0) ∨ ((8 : Fin 9) = 2) ∨ ((8 : Fin 9) = 4)) by decide) φ
  fin_cases l
  · show (0 : ℝ) = 0 - dropAt hb2 hb3 hb4 ρ 0 φ
    simp [dropAt]
  · show (N.toHF hb2 hb3 hb4 z2 z3 z4 hunh hz2 hz3 hz4).hcost ρ 0 φ = N.hcost ρ 0 φ - dropAt hb2 hb3 hb4 ρ 1 φ
    rw [k0]; simp [dropAt]
  · show (N.toHF hb2 hb3 hb4 z2 z3 z4 hunh hz2 hz3 hz4).hcost ρ 1 φ = N.hcost ρ 1 φ - dropAt hb2 hb3 hb4 ρ 2 φ
    rw [n1]; simp [dropAt]
  · show (N.toHF hb2 hb3 hb4 z2 z3 z4 hunh hz2 hz3 hz4).hcost ρ 2 φ = N.hcost ρ 2 φ - dropAt hb2 hb3 hb4 ρ 3 φ
    rw [k2]; simp [dropAt]
  · show (N.toHF hb2 hb3 hb4 z2 z3 z4 hunh hz2 hz3 hz4).hcost ρ 3 φ = N.hcost ρ 3 φ - dropAt hb2 hb3 hb4 ρ 4 φ
    rw [n3]; simp [dropAt]
  · show (N.toHF hb2 hb3 hb4 z2 z3 z4 hunh hz2 hz3 hz4).hcost ρ 4 φ = N.hcost ρ 4 φ - dropAt hb2 hb3 hb4 ρ 5 φ
    rw [k4]; simp [dropAt]
  · show (N.toHF hb2 hb3 hb4 z2 z3 z4 hunh hz2 hz3 hz4).hcost ρ 5 φ = N.hcost ρ 5 φ - dropAt hb2 hb3 hb4 ρ 6 φ
    rw [n5]; simp [dropAt]
  · show (0 : ℝ) = 0 - dropAt hb2 hb3 hb4 ρ 7 φ
    simp [dropAt]
  · show (N.toHF hb2 hb3 hb4 z2 z3 z4 hunh hz2 hz3 hz4).hcost ρ 6 φ
        + (N.toHF hb2 hb3 hb4 z2 z3 z4 hunh hz2 hz3 hz4).hcost ρ 7 φ
        + (N.toHF hb2 hb3 hb4 z2 z3 z4 hunh hz2 hz3 hz4).hcost ρ 8 φ
        + (Fintype.card T : ℝ) * (N.cX4 φ + N.cY4 φ)
      = N.hcost ρ 6 φ + N.hcost ρ 7 φ + N.hcost ρ 8 φ + (Fintype.card T : ℝ) * (N.cX4 φ + N.cY4 φ)
        - dropAt hb2 hb3 hb4 ρ 8 φ
    rw [n6, n7, n8]; simp [dropAt]

include hf2 hf3 hf4 in
/-- **the price of the body network**: the network's, less one block per head bin (rank 16, 32 or 48). -/
theorem XNetW.unit_toHF (φ : ℕ → ℝ) :
    (N.toHF hb2 hb3 hb4 z2 z3 z4 hunh hz2 hz3 hz4).unit φ
      = N.unit φ - ((hb2.card : ℝ) * φ 16 + (hb3.card : ℝ) * φ 32 + (hb4.card : ℝ) * φ 48) := by
  have hc : ∀ ρ l, (N.toHF hb2 hb3 hb4 z2 z3 z4 hunh hz2 hz3 hz4).callU ρ l φ
      = N.callU ρ l φ - dropAt hb2 hb3 hb4 ρ l φ := by
    intro ρ l
    show (N.Ic ρ l).cost φ + (N.toHF hb2 hb3 hb4 z2 z3 z4 hunh hz2 hz3 hz4).tailU ρ l φ
      = (N.Ic ρ l).cost φ + N.tailU ρ l φ - _
    rw [N.tailU_toHF hb2 hb3 hb4 z2 z3 z4 hunh hz2 hz3 hz4 hf2 hf3 hf4]
    ring
  show (∑ ρ : Fin nR, ∑ l : Fin 9, (N.toHF hb2 hb3 hb4 z2 z3 z4 hunh hz2 hz3 hz4).callU ρ l φ)
      + ∑ b, bcost φ (N.pad b)
    = (∑ ρ : Fin nR, ∑ l : Fin 9, N.callU ρ l φ) + ∑ b, bcost φ (N.pad b)
      - ((hb2.card : ℝ) * φ 16 + (hb3.card : ℝ) * φ 32 + (hb4.card : ℝ) * φ 48)
  simp only [hc, dropAt, Finset.sum_sub_distrib, Finset.sum_add_distrib, Finset.sum_ite_eq', Finset.mem_univ,
    if_true]
  rw [sum_hdropR 16 hb2 φ, sum_hdropR 32 hb3 φ, sum_hdropR 48 hb4 φ]
  ring

end HF
