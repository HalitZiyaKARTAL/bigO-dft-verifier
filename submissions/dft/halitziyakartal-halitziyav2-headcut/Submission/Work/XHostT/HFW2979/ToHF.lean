lemma XNetW.hremHF_ne {c : Fin 9} (hc : ¬ (c = 0 ∨ c = 2 ∨ c = 4)) (ρ : Fin nR) (j : Bool × T) :
    N.hremHF hb2 hb3 hb4 ρ c j = N.hrem ρ c j := if_neg (isHd_ne hb2 hb3 hb4 hc ρ j)

lemma XNetW.hHP_HF (ρh : Fin nR) (c : Fin 9) (τ : ℕ) (g : Γ) (j : Bool × T) :
