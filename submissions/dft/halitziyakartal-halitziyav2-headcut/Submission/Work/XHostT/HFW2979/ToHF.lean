/-- the start frames of the A2, A3 and A4 chains of `N` (those of `hH0_A2`, `hH0_A3`, `hH0_A4`: the same). -/
def XNetW.x0A4 (g : Γ) : Bool × T → CMat α
  | (false, t) => (N.G0 g).Xm.Φ (tt (N.I.tv t))
  | (true, _) => (N.G0 g).Xm.Φ 0

/-- the A2 end frames of `N` (those of `hHE_A2`). -/
def XNetW.x1A2 (g : Γ) : Bool × T → CMat α
  | (false, t) => (N.G1 (N.r1 t g)).Xm.Φ 1
  | (true, t) => (N.G1 (N.r1 t g)).Xm.Φ (1 + tt (N.I.tv t))

/-- the A3 end frames of `N` (those of `hHE_A3`). -/
def XNetW.x1A3 (g : Γ) : Bool × T → CMat α
  | (false, t) => (N.G3 (N.r3 t g)).Xm.Φ 1
  | (true, t) => (N.G3 (N.r3 t g)).Xm.Φ (1 + tt (N.I.tv t))

/-- the A4 end frames of `N` (those of `hHE_A4`). -/
def XNetW.x1A4 (g : Γ) : Bool × T → CMat α
  | (false, t) => (N.G5 (N.r5 t g)).Xm.Φ 1
  | (true, t) => (N.G5 (N.r5 t g)).Xm.Φ (1 + tt (N.I.tv t))

variable (hb2 hb3 hb4 : Finset (Fin nR × Bool × T)) (z2 : BLiveT Γ T nb nR → Fin 16 → Space α)
  (z3 : BLiveT Γ T nb nR → Fin 32 → Space α) (z4 : BLiveT Γ T nb nR → Fin 48 → Space α)

/-- the head condition of host `(ρh, c, j)`: an A2 bin of `hb2`, an A3 bin of `hb3` or an A4 bin of `hb4`. -/
def isHd (ρh : Fin nR) (c : Fin 9) (j : Bool × T) : Prop :=
  (c = 0 ∧ (ρh, j) ∈ hb2) ∨ (c = 2 ∧ (ρh, j) ∈ hb3) ∨ (c = 4 ∧ (ρh, j) ∈ hb4)

instance (ρh : Fin nR) (c : Fin 9) (j : Bool × T) : Decidable (isHd hb2 hb3 hb4 ρh c j) := by
  unfold isHd; infer_instance

/-- the head block of host `(ρh, c, j)` in gauge `g` (only head hosts matter). -/
def hdM (ρh : Fin nR) (c : Fin 9) (g : Γ) (j : Bool × T) : CMat α :=
  if c = 0 then blockMat (z2 (hroleP 2 ρh g j)) else if c = 2 then blockMat (z3 (hroleP 3 ρh g j))
  else blockMat (z4 (hroleP 4 ρh g j))

/-- the host chains of the body network (head bins: constantly the head block times the start frame). -/
def XNetW.hbHF (ρh : Fin nR) (c : Fin 9) (τ : ℕ) (g : Γ) (j : Bool × T) : CMat α :=
  if isHd hb2 hb3 hb4 ρh c j then hdM z2 z3 z4 ρh c g j * N.x0A4 g j else N.Hb ρh c τ g j

def XNetW.hpHF (ρh : Fin nR) (c : Fin 9) (τ : ℕ) (g : Γ) (j : Bool × T) : CMat α :=
  if isHd hb2 hb3 hb4 ρh c j then hdM z2 z3 z4 ρh c g j * N.x0A4 g j else N.Hp ρh c τ g j

/-- the remaining climbs of the body network (head bins: `0`). -/
def XNetW.hremHF (ρ : Fin nR) (c : Fin 9) (j : Bool × T) : ℕ :=
  if isHd hb2 hb3 hb4 ρ c j then 0 else N.hrem ρ c j

lemma isHd_ne {c : Fin 9} (hc : ¬ (c = 0 ∨ c = 2 ∨ c = 4)) (ρh : Fin nR) (j : Bool × T) :
    ¬ isHd hb2 hb3 hb4 ρh c j := by
  rintro (⟨h, -⟩ | ⟨h, -⟩ | ⟨h, -⟩)
  · exact hc (Or.inl h)
  · exact hc (Or.inr (Or.inl h))
  · exact hc (Or.inr (Or.inr h))

lemma isHd_0 (ρh : Fin nR) (j : Bool × T) : isHd hb2 hb3 hb4 ρh 0 j ↔ (ρh, j) ∈ hb2 := by
  unfold isHd
  constructor
  · rintro (⟨-, h⟩ | ⟨h, -⟩ | ⟨h, -⟩)
    · exact h
    · exact absurd h (by decide)
    · exact absurd h (by decide)
  · exact fun h => Or.inl ⟨rfl, h⟩

