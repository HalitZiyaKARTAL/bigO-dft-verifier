lemma XNetW.hbHF_ne {c : Fin 9} (hc : ¬ (c = 0 ∨ c = 2 ∨ c = 4)) (ρh : Fin nR) (τ : ℕ) (g : Γ) (j : Bool × T) :
    N.hbHF hb2 hb3 hb4 z2 z3 z4 ρh c τ g j = N.Hb ρh c τ g j := if_neg (isHd_ne hb2 hb3 hb4 hc ρh j)

