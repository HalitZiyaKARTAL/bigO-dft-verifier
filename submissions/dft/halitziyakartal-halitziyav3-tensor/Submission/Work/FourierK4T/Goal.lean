namespace OAI

namespace PowerSaving
noncomputable section
open RAM RAM.Ty Filter Asymptotics

def decimalExponentK4T : ℝ := 1 - 26159999/(10^(10:ℕ))

def decimalTimeK4T (n : ℕ) : ℝ := (n:ℝ) * (Real.log (n:ℝ)) ^ decimalExponentK4T

/-- Thm 1 (intro main) and decimal corollary estimates. -/
def TimeBoundsK4T (W : ℕ → ℕ) : Prop :=
  let W' := fun n : ℕ => (W n : ℝ)
  W' =O[atTop] paperTime ∧ W' =O[atTop] decimalTimeK4T ∧ W' =o[atTop] nlogn

def DFTGoalK4T : Prop := ∃ order solve W, DFTProgram order solve W ∧ TimeBoundsK4T W

def ConvGoalK4T : Prop := ∃ order solve W, ConvProgram order solve W ∧ TimeBoundsK4T W

end
end PowerSaving

end OAI
