namespace OAI

/-!
Exact uniform Fourier transforms and convolution.

The construction formalizes the exact arithmetic algorithms of
*An explicit power saving for the exact discrete Fourier transform* (OpenAI).
The finite phase network originates in the complex construction of
*Integer multiplication below n log n*.

`transform_mainK4T` and `convolution_mainK4T` give fixed finite RAM programs, including
preparation and index work, polynomial storage bounds, and a canonical root whose
order is computed from the input length. Each includes the paper exponent, decimal
power saving, and little-o bound. The `_order` variants also specify the root order.

The implementation uses a smaller concrete tensor network (32 binary coordinates
per factor, 4060 triples, and a `2^50` role envelope) with a stronger saving that
implies the stated paper constants. The general rational-algebra extraction,
symbolic certificate search, circuit printer, and bounded-printer uniformization
from the synthesis appendix are outside this formalization.
-/
namespace PowerSaving
open RAM Bench Selection Filter Asymptotics Real
noncomputable section
namespace Skies

lemma multiplier_rangeK4T : 1 < paperMultiplier ∧ paperMultiplier < paperM := by
  norm_num [paperMultiplier,paperM,paperDelta,paperW]

lemma theta_ltK4T : theta < 1 := by
  have h := multiplier_rangeK4T
  have hg : 0<log paperM := Real.log_pos (lt_trans h.1 h.2)
  rw [theta,div_lt_iff₀ hg,one_mul]
  exact Real.log_lt_log (by linarith) h.2

lemma alpha_thetaK4T : alphaK4T < theta := by
  let d : ℝ := 2615999999/(10:ℝ)^12
  have hp : 0<d := by dsimp [d]; norm_num
  have hm : 2 ≤ paperM := by norm_num [paperM]
  have hx : 0<paperMultiplier := lt_trans zero_lt_one multiplier_rangeK4T.1
  have hu : 0<paperM := by linarith
  have h2 := (Real.log_le_log (by norm_num : 0 < (2:ℝ)) hm)
  have he := log2_minK4T
  have hh : 0<log paperM := by linarith
  have hk := Real.log_le_sub_one_of_pos (show 0<paperM/paperMultiplier by positivity)
  rw [log_div hu.ne' hx.ne'] at hk
  have H : paperM/paperMultiplier-1 < d*(2/3) := by
    norm_num [d,paperM,paperMultiplier,paperW,paperDelta]
  rw [theta,lt_div_iff₀ hh]
  change (1-d)*log paperM < log paperMultiplier
  have H' := mul_le_mul_of_nonneg_left (he.trans h2) hp.le
  have hy := hk.trans_lt (lt_of_lt_of_le H H')
  rw [sub_mul,one_mul]
  linarith only [hy]

lemma decimal_rangeK4T : alphaK4T < decimalExponentK4T ∧ decimalExponentK4T < 1 := by
  norm_num [decimalExponentK4T,alphaK4T]

def speedK4T (v : ℝ) (n : ℕ) := (n:ℝ)*(TmK4T n)^v

lemma flight_littleK4T {v : ℝ} (h : alphaK4T < v) :
    flightK4T =o[atTop] speedK4T v := by
  rw [isLittleO_iff]
  intro c hc
  filter_upwards [TtopK4T.eventually_ge_atTop 1,dwarfK4T TtopK4T 2
    (p:=v-alphaK4T) (sub_pos.mpr h) hc] with n hn hh
  have he : 0<TmK4T n := by linarith
  change ‖(n:ℝ)*TmK4T n^alphaK4T*QmK4T n^2‖ ≤ c*‖(n:ℝ)*TmK4T n^v‖
  rw [Real.norm_of_nonneg (by positivity),Real.norm_of_nonneg (by positivity)]
  calc
    _ ≤ ((n:ℝ)*TmK4T n^alphaK4T)*(c*TmK4T n^(v-alphaK4T)) :=
      mul_le_mul_of_nonneg_left hh (by positivity)
    _ = c*((n:ℝ)*(TmK4T n^alphaK4T*TmK4T n^(v-alphaK4T))) := by ring
    _ = _ := by rw [← rpow_add he, show alphaK4T + (v-alphaK4T)=v by ring] -- a+(v-a)

lemma speed_littleK4T {u v : ℝ} (h : u < v) :
    speedK4T u =o[atTop] speedK4T v := by
  rw [isLittleO_iff]
  intro c hc
  filter_upwards [TtopK4T.eventually_ge_atTop 1,dwarfK4T TtopK4T 0
    (p:=v-u) (sub_pos.mpr h) hc] with n hn hh
  have he : 0<TmK4T n := by linarith
  change ‖(n:ℝ)*TmK4T n^u‖ ≤ c*‖(n:ℝ)*TmK4T n^v‖
  rw [Real.norm_of_nonneg (by positivity),Real.norm_of_nonneg (by positivity)]
  have hh' : 1 ≤ c * TmK4T n^(v-u) := by simpa only [pow_zero] using hh
  calc
    _ = ((n:ℝ)*TmK4T n^u)*1 := by ring
    _ ≤ ((n:ℝ)*TmK4T n^u)*(c*TmK4T n^(v-u)) := mul_le_mul_of_nonneg_left hh' (by positivity)
    _ = c*((n:ℝ)*(TmK4T n^u*TmK4T n^(v-u))) := by ring
    _ = _ := by rw [← rpow_add he, show u+(v-u)=v by ring]

theorem decimal_littleK4T : decimalTimeK4T =o[atTop] nlogn := by
  have H := speed_littleK4T decimal_rangeK4T.2
  have h : speedK4T 1 = nlogn := funext fun n => by rw [speedK4T,Real.rpow_one]; rfl
  rw [h] at H; exact H

lemma speed_paperK4T : speedK4T theta =O[atTop] paperTime := by
  rw [isBigO_iff]
  refine ⟨1,?_⟩
  filter_upwards [TtopK4T.eventually_ge_atTop 1,QtopK4T.eventually_ge_atTop 1] with n hn hh
  have he : 0<TmK4T n := by linarith
  have he' : 0<QmK4T n := by linarith
  change ‖(n:ℝ)*TmK4T n^theta‖ ≤ 1*‖(n:ℝ)*TmK4T n^theta*QmK4T n^(4-theta)‖
  rw [Real.norm_of_nonneg (by positivity),Real.norm_of_nonneg (by positivity),one_mul]
  have hb := Real.one_le_rpow hh (show 0 ≤ 4-theta by linarith [theta_ltK4T])
  exact le_mul_of_one_le_right (by positivity) hb

lemma time_boundK4T {N} (h : ∀ n:ℕ,n ≤ N n ∧ N n ≤ 2*n) (a b : RationK4T) :
    TimeBoundsK4T (lunchK4T a b N) := by
  have H := lunch_bigK4T a b h
  have hp := H.trans_isLittleO (flight_littleK4T alpha_thetaK4T)
  have hd := H.trans_isLittleO (flight_littleK4T decimal_rangeK4T.1)
  have ht : (fun n => (lunchK4T a b N n:ℝ)) =O[atTop] decimalTimeK4T := hd.isBigO
  exact ⟨hp.isBigO.trans speed_paperK4T,ht,ht.trans_isLittleO decimal_littleK4T⟩

end Skies

/-! Main results. Provide formula for the order besides the existential specification. -/
theorem transform_main_orderK4T : ∃ order solve W,
    DFTProgram order solve W ∧ TimeBoundsK4T W ∧
    ∀ n, 0<n → (run order n).val = receipt n ∧ (run order n).val < 8*n^3 := by
  obtain ⟨o,s,a,b,hp,ho⟩ := flagshipOneK4T
  exact ⟨o,s,lunchK4T a b id,hp,Skies.time_boundK4T (N:=id) (fun n => ⟨le_rfl,by dsimp; omega⟩)
    a b,fun n hn => ⟨ho n hn,(ho n hn).symm ▸ (receipt_bound n hn).2⟩⟩

theorem convolution_main_orderK4T : ∃ order solve W,
    ConvProgram order solve W ∧ TimeBoundsK4T W ∧
    ∀ n, 0<n → (run order n).val = receipt (2*n-1) ∧ (run order n).val < 8*(2*n-1)^3 := by
  obtain ⟨o,s,a,b,hp,ho⟩ := flagshipBothK4T
  have h (n : ℕ) : n ≤ stretchK4T n ∧ stretchK4T n ≤ 2*n := by unfold stretchK4T; omega
  exact ⟨o,s,lunchK4T a b stretchK4T,hp,Skies.time_boundK4T h a b,fun n hn =>
    ⟨ho n hn,(ho n hn).symm ▸ (receipt_bound _ (stretch_posK4T hn)).2⟩⟩

/-- **The discrete Fourier transform of every length in `O(n (log n)^(1 - 26159999/10^10))`.**
OpenAI's `transform_main` (one fixed program, OpenAI's own `DFTProgram`, `paperTime` and `nlogn`)
with the decimal exponent `1 - 1/10^13` replaced by `decimalExponentK4T = 1 - 26159999/10^10`
(Work/FourierK4T/Goal.lean). Sibling of the Walsh-Hadamard theorem `wht_main_block_K4T_x`: both
follow from one kernel program, `RAM.hillsK4T_program` (Work/FourierK4T/Seam.lean). -/
theorem transform_mainK4T : DFTGoalK4T :=
  let ⟨o,s,W,h,g,_⟩ := transform_main_orderK4T
  ⟨o,s,W,h,g⟩

/-- **Convolution of every length with the same bounds** (OpenAI's `convolution_main`, same change). -/
theorem convolution_mainK4T : ConvGoalK4T :=
  let ⟨o,s,W,h,g,_⟩ := convolution_main_orderK4T
  ⟨o,s,W,h,g⟩

