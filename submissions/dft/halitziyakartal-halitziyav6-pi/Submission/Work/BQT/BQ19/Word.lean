  | .inr (_, (_, q)) => ⟨(D q).card, FH.targ (D q)⟩

lemma rawTz_indep (D : Sl → Finset (LC (Fin 18) H l)) (l' : PLive (Orth (LC (Fin 18) H l)) T Sl) : LinearIndependent F (rawTz base l D l').2 := by
  rcases l' with ⟨g, i, t⟩ | ⟨g, k, q⟩
  · exact OBase.fam_indep (G19.basisA base l g t) (tgtS l i)
  · exact FH.targ_indep (D q)

