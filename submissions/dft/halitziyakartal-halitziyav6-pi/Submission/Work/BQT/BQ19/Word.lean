  19 * ((Fintype.card (Orth (LC (Fin 18) H l)) : ℝ) * I.cost φ)
    + (Fintype.card (Orth (LC (Fin 18) H l)) : ℝ) * (Fintype.card T : ℝ) * portCost φ

