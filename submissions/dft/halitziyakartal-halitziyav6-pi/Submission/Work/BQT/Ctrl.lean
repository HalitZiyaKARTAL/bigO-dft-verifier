variable {R : Type*} [CommRing R]

/-- a full forward native call on the pair `(x, y)`: `y += qi x`, then the stage transform `d` on the pair. -/
def callF (x y : R34) (d qi : R) (u : S34 R) : S34 R :=
  (u.set x (d * u.get x)).set y (d * (u.get y + qi * u.get x))

/-- a full backward native call on the pair `(x, y)`: `x -= q y`, then the stage transform `d` on the pair. -/
def callB (x y : R34) (d q : R) (u : S34 R) : S34 R :=
  (u.set x (d * (u.get x - q * u.get y))).set y (d * u.get y)

/-- a THIN query on the pair `(x, y)`: `y += qi x` (no stage transform). -/
def shear (x y : R34) (qi : R) (u : S34 R) : S34 R := u.set y (u.get y + qi * u.get x)

/-- a THIN query with the opposite orientation: `y += q x` (new in this entry; `frame` instead of `unframe`). -/
def shearQ (x y : R34) (q : R) (u : S34 R) : S34 R := u.set y (u.get y + q * u.get x)

/-- a plain exchange of two main roles (new in this entry). -/
def pswap (x y : R34) (u : S34 R) : S34 R := (u.set x (u.get y)).set y (u.get x)

/-- one main role times a scalar (new in this entry; the caller uses `-1`). -/
def scale (x : R34) (c : R) (u : S34 R) : S34 R := u.set x (c * u.get x)

/-- an idle window of the pair `(x, y)`: both roles times `m`. -/
def win (x y : R34) (m : R) (u : S34 R) : S34 R := (u.set x (m * u.get x)).set y (m * u.get y)

/-- a bridge gate: role `dst` += `c` role `src`. -/
def gate (dst src : R34) (c : R) (u : S34 R) : S34 R := u.set dst (u.get dst + c * u.get src)

/-- the signed exchange of the pair `(x, y)`: `(x, y) ↦ (y, -x)`. -/
def swap (x y : R34) (u : S34 R) : S34 R := (u.set x (u.get y)).set y (-u.get x)

