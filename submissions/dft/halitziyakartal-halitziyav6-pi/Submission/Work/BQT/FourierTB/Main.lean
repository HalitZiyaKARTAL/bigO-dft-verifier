lemma multiplier_rangeTB19 : 1 < paperMultiplier ∧ paperMultiplier < paperM := by
  norm_num [paperMultiplier,paperM,paperDelta,paperW]

lemma theta_ltTB19 : theta < 1 := by
  have h := multiplier_rangeTB19
  have hg : 0<log paperM := Real.log_pos (lt_trans h.1 h.2)
  rw [theta,div_lt_iff₀ hg,one_mul]
  exact Real.log_lt_log (by linarith) h.2

lemma alpha_thetaTB19 : alphaTB19 < theta := by
  let d : ℝ := 3148496240/(10:ℝ)^12
  have hp : 0<d := by dsimp [d]; norm_num
  have hm : 2 ≤ paperM := by norm_num [paperM]
  have hx : 0<paperMultiplier := lt_trans zero_lt_one multiplier_rangeTB19.1
  have hu : 0<paperM := by linarith
  have h2 := (Real.log_le_log (by norm_num : 0 < (2:ℝ)) hm)
  have he := log2_minTB19
  have hh : 0<log paperM := by linarith
  have hk := Real.log_le_sub_one_of_pos (show 0<paperM/paperMultiplier by positivity)
  rw [log_div hu.ne' hx.ne'] at hk
  have H : paperM/paperMultiplier-1 < d*(2/3) := by
    norm_num [d,paperM,paperMultiplier,paperW,paperDelta]
  rw [theta,lt_div_iff₀ hh]
  change (1-d)*log paperM < log paperMultiplier
  have H' := mul_le_mul_of_nonneg_left (he.trans h2) hp.le
  have hy := hk.trans_lt (lt_of_lt_of_le H H')
  rw [sub_mul,one_mul]
  linarith only [hy]

lemma decimal_rangeTB19 : alphaTB19 < decimalExponentTB19 ∧ decimalExponentTB19 < 1 := by
  refine ⟨?_, ?_⟩ <;> norm_num [decimalExponentTB19,alphaTB19,statedSavingTB19] <;>
    linarith [SeamTB19.pi_lt_TB19, Real.pi_gt_three]

def speedTB19 (v : ℝ) (n : ℕ) := (n:ℝ)*(TmTB19 n)^v

lemma flight_littleTB19 {v : ℝ} (h : alphaTB19 < v) :
    flightTB19 =o[atTop] speedTB19 v := by
  rw [isLittleO_iff]
  intro c hc
  filter_upwards [TtopTB19.eventually_ge_atTop 1,dwarfTB19 TtopTB19 2
    (p:=v-alphaTB19) (sub_pos.mpr h) hc] with n hn hh
  have he : 0<TmTB19 n := by linarith
  change ‖(n:ℝ)*TmTB19 n^alphaTB19*QmTB19 n^2‖ ≤ c*‖(n:ℝ)*TmTB19 n^v‖
  rw [Real.norm_of_nonneg (by positivity),Real.norm_of_nonneg (by positivity)]
  calc
    _ ≤ ((n:ℝ)*TmTB19 n^alphaTB19)*(c*TmTB19 n^(v-alphaTB19)) :=
      mul_le_mul_of_nonneg_left hh (by positivity)
    _ = c*((n:ℝ)*(TmTB19 n^alphaTB19*TmTB19 n^(v-alphaTB19))) := by ring
    _ = _ := by rw [← rpow_add he, show alphaTB19 + (v-alphaTB19)=v by ring] -- a+(v-a)

lemma speed_littleTB19 {u v : ℝ} (h : u < v) :
    speedTB19 u =o[atTop] speedTB19 v := by
  rw [isLittleO_iff]
  intro c hc
  filter_upwards [TtopTB19.eventually_ge_atTop 1,dwarfTB19 TtopTB19 0
    (p:=v-u) (sub_pos.mpr h) hc] with n hn hh
  have he : 0<TmTB19 n := by linarith
  change ‖(n:ℝ)*TmTB19 n^u‖ ≤ c*‖(n:ℝ)*TmTB19 n^v‖
  rw [Real.norm_of_nonneg (by positivity),Real.norm_of_nonneg (by positivity)]
  have hh' : 1 ≤ c * TmTB19 n^(v-u) := by simpa only [pow_zero] using hh
  calc
    _ = ((n:ℝ)*TmTB19 n^u)*1 := by ring
    _ ≤ ((n:ℝ)*TmTB19 n^u)*(c*TmTB19 n^(v-u)) := mul_le_mul_of_nonneg_left hh' (by positivity)
    _ = c*((n:ℝ)*(TmTB19 n^u*TmTB19 n^(v-u))) := by ring
    _ = _ := by rw [← rpow_add he, show u+(v-u)=v by ring]

theorem decimal_littleTB19 : decimalTimeTB19 =o[atTop] nlogn := by
  have H := speed_littleTB19 decimal_rangeTB19.2
  have h : speedTB19 1 = nlogn := funext fun n => by rw [speedTB19,Real.rpow_one]; rfl
  rw [h] at H; exact H

lemma speed_paperTB19 : speedTB19 theta =O[atTop] paperTime := by
  rw [isBigO_iff]
  refine ⟨1,?_⟩
  filter_upwards [TtopTB19.eventually_ge_atTop 1,QtopTB19.eventually_ge_atTop 1] with n hn hh
  have he : 0<TmTB19 n := by linarith
  have he' : 0<QmTB19 n := by linarith
  change ‖(n:ℝ)*TmTB19 n^theta‖ ≤ 1*‖(n:ℝ)*TmTB19 n^theta*QmTB19 n^(4-theta)‖
  rw [Real.norm_of_nonneg (by positivity),Real.norm_of_nonneg (by positivity),one_mul]
  have hb := Real.one_le_rpow hh (show 0 ≤ 4-theta by linarith [theta_ltTB19])
  exact le_mul_of_one_le_right (by positivity) hb

lemma time_boundTB19 {N} (h : ∀ n:ℕ,n ≤ N n ∧ N n ≤ 2*n) (a b : RationTB19) :
    TimeBoundsTB19 (lunchTB19 a b N) := by
  have H := lunch_bigTB19 a b h
  have hp := H.trans_isLittleO (flight_littleTB19 alpha_thetaTB19)
  have hd := H.trans_isLittleO (flight_littleTB19 decimal_rangeTB19.1)
  have ht : (fun n => (lunchTB19 a b N n:ℝ)) =O[atTop] decimalTimeTB19 := hd.isBigO
  exact ⟨hp.isBigO.trans speed_paperTB19,ht,ht.trans_isLittleO decimal_littleTB19⟩

