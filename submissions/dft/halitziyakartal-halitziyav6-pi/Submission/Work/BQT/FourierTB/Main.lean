/-! Main results. Provide formula for the order besides the existential specification. -/
theorem transform_main_orderTB19 : ∃ order solve W,
    DFTProgram order solve W ∧ TimeBoundsTB19 W ∧
    ∀ n, 0<n → (run order n).val = receipt n ∧ (run order n).val < 8*n^3 := by
  obtain ⟨o,s,a,b,hp,ho⟩ := flagshipOneTB19
  exact ⟨o,s,lunchTB19 a b id,hp,Skies.time_boundTB19 (N:=id) (fun n => ⟨le_rfl,by dsimp; omega⟩)
    a b,fun n hn => ⟨ho n hn,(ho n hn).symm ▸ (receipt_bound n hn).2⟩⟩

theorem convolution_main_orderTB19 : ∃ order solve W,
    ConvProgram order solve W ∧ TimeBoundsTB19 W ∧
    ∀ n, 0<n → (run order n).val = receipt (2*n-1) ∧ (run order n).val < 8*(2*n-1)^3 := by
  obtain ⟨o,s,a,b,hp,ho⟩ := flagshipBothTB19
  have h (n : ℕ) : n ≤ stretchTB19 n ∧ stretchTB19 n ≤ 2*n := by unfold stretchTB19; omega
  exact ⟨o,s,lunchTB19 a b stretchTB19,hp,Skies.time_boundTB19 h a b,fun n hn =>
    ⟨ho n hn,(ho n hn).symm ▸ (receipt_bound _ (stretch_posTB19 hn)).2⟩⟩

/-- **The discrete Fourier transform of every length in `O(n (log n)^(1 - π/1000))`** (`statedSavingTB19 = π/1000`).
OpenAI's `transform_main` (one fixed program, OpenAI's own `DFTProgram`, `paperTime` and `nlogn`)
with the decimal exponent `1 - 1/10^13` replaced by `decimalExponentTB19 = 1 - statedSavingTB19`
(Work/BQT/FourierTB/Goal.lean), from the kernel program `RAM.hillsTB19_program`
(Work/BQT/FourierTB/Merged1.lean, section Seam). -/
theorem transform_mainTB19 : DFTGoalTB19 :=
  let ⟨o,s,W,h,g,_⟩ := transform_main_orderTB19
  ⟨o,s,W,h,g⟩

/-- **Convolution of every length with the same bounds** (OpenAI's `convolution_main`, same change). -/
theorem convolution_mainTB19 : ConvGoalTB19 :=
  let ⟨o,s,W,h,g,_⟩ := convolution_main_orderTB19
  ⟨o,s,W,h,g⟩

