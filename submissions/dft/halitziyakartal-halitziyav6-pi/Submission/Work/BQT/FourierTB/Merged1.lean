/-! ## 1. The exponent and the envelope facts -/

/-- Our exponent, in the place of OpenAI's `alpha` (TensorSaving.lean:81). -/
def alphaTB19 : ℝ := 1 - 3148496240/(10:ℝ)^12

theorem alphaTB19_pos : 0 < alphaTB19 := by norm_num [alphaTB19]
theorem alphaTB19_lt : alphaTB19 < 1 := by norm_num [alphaTB19]

lemma envelope_monoTB19 (z : ℝ) (hz : 0 ≤ z) {a b : ℕ} (h : a ≤ b) : envelope z a ≤ envelope z b := by
  unfold envelope
  gcongr

-- `envelope_le` (for `z ≤ 1`) and `envelope_real` (for `0 ≤ z`) already exist: Work/Block/WHT.lean:26, :31.

lemma envelope_mono_expTB19 {z z' : ℝ} (h : z ≤ z') (k : ℕ) : envelope z k ≤ envelope z' k := by
  unfold envelope
  exact Nat.ceil_le_ceil (Real.rpow_le_rpow_of_exponent_le (by simp) h)

/-- Natural envelope at our exponent, in the place of OpenAI's `hills` (TensorSaving.lean:114). -/
def hillsTB19 (k : ℕ) := Nat.ceil (((k:ℝ)+1)^alphaTB19)

lemma hillsTB19_eq_envelope : hillsTB19 = envelope alphaTB19 := rfl

lemma hillsTB19_pos (k : ℕ) : 1≤hillsTB19 k := envelope_pos alphaTB19 k

lemma hillsTB19_mono {a b : ℕ} (h : a≤b) : hillsTB19 a ≤ hillsTB19 b := envelope_monoTB19 alphaTB19 alphaTB19_pos.le h

lemma hillsTB19_le (k : ℕ) : hillsTB19 k ≤ k+1 := envelope_le alphaTB19 alphaTB19_lt.le k

lemma hillsTB19_real (k : ℕ) : (hillsTB19 k:ℝ) ≤ 2*((k:ℝ)+1)^alphaTB19 := envelope_real alphaTB19 alphaTB19_pos.le k

/-! ## 3. The kernel program at `alphaTB19` -/

namespace SeamTB19
open Binary Matrix Finset RAM RAM.Ty
universe U

/-- **Kernel program at `alphaTB19 = 1 - 3148496240/10^12`**: every colour, both modes, every batch of inputs. -/
theorem engine_TB19 (cl : Paint) (m : Bool) {ι : Type U} (k : ι→ℕ) (v : ∀ i, Bits (k i) → ℂ) :
    Can m (fun i => 2^k i) (simIn cl) (bundle cl)
      (fun i => givenBits cl (k i) (v i)) (fun i => (bits (k i)).tape (ripple (k i) (v i)))
      (fun i => 2^k i*envelope alphaTB19 (k i)) :=
  MX.TB19.EngineStmt.lift MX.TB19.engine cl m k v

end SeamTB19

/-! ## 4. THE SEAM -/

namespace RAM
open Binary Matrix Ty Finset
universe U

/-- **THE SEAM.**  OpenAI's `hills_program` (TensorProgram.lean:95) word for word, with `hillsTB19`
(exponent `1 - 3148496240/10^12`) in the place of `hills` (exponent `1 - 2/10^11`): the kernel program `SeamTB19.engine_TB19`, for every colour,
both modes and every batch of inputs, in `2^k * hillsTB19 k` operations. -/
theorem hillsTB19_program (cl : Paint) (m : Bool) {ι : Type U} (k : ι→ℕ)
    (v : ∀ i, Bits (k i) → ℂ) :
    Can m (fun i => 2^k i) (simIn cl) (bundle cl)
      (fun i => givenBits cl (k i) (v i)) (fun i => (bits (k i)).tape (ripple (k i) (v i)))
      (fun i => 2^k i*hillsTB19 (k i)) :=
  SeamTB19.engine_TB19 cl m k v

/-- **General exponent**: the same at every exponent `z ≥ alphaTB19`, envelope `⌈(k+1)^z⌉`. -/
theorem envelope_program_geTB19 (z : ℝ) (hz : alphaTB19 ≤ z) (cl : Paint) (m : Bool) {ι : Type U} (k : ι→ℕ)
    (v : ∀ i, Bits (k i) → ℂ) :
    Can m (fun i => 2^k i) (simIn cl) (bundle cl)
      (fun i => givenBits cl (k i) (v i)) (fun i => (bits (k i)).tape (ripple (k i) (v i)))
      (fun i => 2^k i*envelope z (k i)) :=
  (hillsTB19_program cl m k v).mono fun i => Nat.mul_le_mul_left _ (envelope_mono_expTB19 hz (k i))

end RAM

