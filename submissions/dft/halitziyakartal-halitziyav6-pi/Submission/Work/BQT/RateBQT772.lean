  intro b _
  rw [Real.div_rpow (Nat.cast_nonneg _) hM'.le, mul_div_assoc', mul_div_assoc',
    mul_div_cancel_left₀ _ hMt.ne']

lemma card_ofHist (l : List (ℕ × ℕ)) : Multiset.card (ofHist l) = (l.map Prod.snd).sum := by
